		Main.Visible = true
		Main.Size = UDim2.new(0, 0, 0, 0)
		TweenService:Create(Main, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Size = UDim2.new(0.19, 0, 0.68, 0)
		}):Play()
	end
end

local pKeyConnection
pKeyConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if not pKeyEnabled then return end
	if input.KeyCode == Enum.KeyCode.P then
		toggleGuiVisibility()
	end
end)

-- ========== CLOSE BUTTON (X) ==========
CloseButton.MouseButton1Click:Connect(function()
	if playersSectionOpen then
		playersSectionOpen = false
		if refreshConn then refreshConn:Disconnect() refreshConn = nil end
		if tpsConnection then tpsConnection:Disconnect() tpsConnection = nil end
		if nearestConnection then nearestConnection:Disconnect() nearestConnection = nil end
		tpsEnabled = false
		nearestEnabled = false
	end
	
	if noclip then
		noclip = false
		NoclipButton.Text = "OFF"
		NoclipButton.TextColor3 = THEME.Error
		NoclipButton.BackgroundColor3 = Color3.fromRGB(30,30,40)
		if player.Character then
			for _, part in pairs(player.Character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = true
				end
			end
			local head = player.Character:FindFirstChild("Head")
			if head and head:IsA("BasePart") then
				head.CanCollide = false
			end
		end
	end
	
	if noclipPlayers then
		noclipPlayers = false
		NoclipPlayersButton.Text = "PLAYERS OFF"
		NoclipPlayersButton.TextColor3 = THEME.Error
		NoclipPlayersButton.BackgroundColor3 = Color3.fromRGB(30,30,40)
		if noclipPlayersConnection then
			noclipPlayersConnection:Disconnect()
			noclipPlayersConnection = nil
		end
		for _, conn in pairs(noclipCharConnections) do
			if conn then conn:Disconnect() end
		end
		noclipCharConnections = {}
		for _, otherPlayer in pairs(Players:GetPlayers()) do
			if otherPlayer ~= player then
				removeNoclipFromPlayer(otherPlayer)
			end
		end
	end
	
	if ecpEnabled then
		disableECP()
	end
	
	if flyEnabled then
		flyEnabled = false
		stopFly()
		FlyButton.Text = "OFF"
		FlyButton.TextColor3 = THEME.Error
		FlyButton.BackgroundColor3 = Color3.fromRGB(30,30,40)
	end
	
	if infiniteJumpEnabled then
		infiniteJumpEnabled = false
		InfiniteButton.Text = "OFF"
		InfiniteButton.TextColor3 = THEME.Error
		if infiniteJumpConnection then
			infiniteJumpConnection:Disconnect()
			infiniteJumpConnection = nil
		end
	end
	
	if spaceJumpEnabled then
		spaceJumpEnabled = false
		SpaceButton.Text = "OFF"
		SpaceButton.TextColor3 = THEME.Error
		if spaceJumpConnection then
			spaceJumpConnection:Disconnect()
			spaceJumpConnection = nil
		end
	end
	
	if originalSpeed ~= 16 then
		originalSpeed = 16
		SpeedBox.Text = ""
		if humanoid then
			humanoid.WalkSpeed = 16
		end
		if walkSpeedConnection then
			walkSpeedConnection:Disconnect()
			walkSpeedConnection = nil
		end
	end
	
	if originalJump ~= 50 then
		originalJump = 50
		JumpBox.Text = ""
		if humanoid then
			humanoid.UseJumpPower = true
			humanoid.JumpPower = 50
			humanoid.JumpHeight = 50/7
		end
		if jumpPowerConnection then
			jumpPowerConnection:Disconnect()
			jumpPowerConnection = nil
		end
	end
	
	if humanoid then
		humanoid.PlatformStand = false
	end
	if bodyVelocity then
		bodyVelocity:Destroy()
		bodyVelocity = nil
	end
	if bodyGyro then
		bodyGyro:Destroy()
		bodyGyro = nil
	end
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end
	
	if flyKeyConnection then
		flyKeyConnection:Disconnect()
		flyKeyConnection = nil
	end
	if pKeyConnection then
		pKeyConnection:Disconnect()
		pKeyConnection = nil
	end
	if respawnConnection then
		respawnConnection:Disconnect()
		respawnConnection = nil
	end
	if removingConnection then
		removingConnection:Disconnect()
		removingConnection = nil
	end
	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end
	
	local closeTween = TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Size = UDim2.new(0, 0, 0, 0)
	})
	closeTween:Play()
	closeTween.Completed:Connect(function()
		ScreenGui:Destroy()
	end)
end)

