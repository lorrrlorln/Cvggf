local restartRunning = false

local function doFullRestart()
	tpsEnabled = false
	nearestEnabled = false
	selectedPlayer = nil
	if tpsConnection then tpsConnection:Disconnect() tpsConnection = nil end
	if nearestConnection then nearestConnection:Disconnect() nearestConnection = nil end
	if refreshConn then refreshConn:Disconnect() refreshConn = nil end
	
	tpsBtn.TextColor3 = THEME.Warning
	tpsBtn.BackgroundColor3 = Color3.fromRGB(30,30,40)
	tpBtn.TextColor3 = THEME.Accent
	tpBtn.BackgroundColor3 = Color3.fromRGB(30,30,40)
	nearBtn.TextColor3 = THEME.Success
	nearBtn.BackgroundColor3 = Color3.fromRGB(30,30,40)
	
	for _, child in pairs(scroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	
	for p, _ in pairs(whitelist) do
		whitelist[p] = nil
	end
	
	noclip = false
	NoclipButton.Text = "OFF"
	NoclipButton.TextColor3 = THEME.Error
	NoclipButton.BackgroundColor3 = Color3.fromRGB(30,30,40)
	if player.Character then
		for _, part in pairs(player.Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
		local head = player.Character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			head.CanCollide = false
		end
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = false
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end
	end
	
	noclipPlayers = false
	NoclipPlayersButton.Text = "PLAYERS OFF"
	NoclipPlayersButton.TextColor3 = THEME.Error
	NoclipPlayersButton.BackgroundColor3 = Color3.fromRGB(30,30,40)
	if noclipPlayersConnection then
		noclipPlayersConnection:Disconnect()
		noclipPlayersConnection = nil
	end
	for _, conn in pairs(noclipCharConnections) do
		if conn then conn:Disconnect() end
	end
	noclipCharConnections = {}
	for _, otherPlayer in pairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			removeNoclipFromPlayer(otherPlayer)
		end
	end
	
	if ecpEnabled then
		disableECP()
	end
	
	if flyEnabled then
		flyEnabled = false
		stopFly()
	end
	FlyButton.Text = "OFF"
	FlyButton.TextColor3 = THEME.Error
	FlyButton.BackgroundColor3 = Color3.fromRGB(30,30,40)
	
	FlyKeyEnabled = true
	updateKeyButton()
	
	flySpeed = 300
	FlySpeedBox.Text = "300"
	
	infiniteJumpEnabled = false
	InfiniteButton.Text = "OFF"
	InfiniteButton.TextColor3 = THEME.Error
	if infiniteJumpConnection then
		infiniteJumpConnection:Disconnect()
		infiniteJumpConnection = nil
	end
	
	spaceJumpEnabled = false
	SpaceButton.Text = "OFF"
	SpaceButton.TextColor3 = THEME.Error
	if spaceJumpConnection then
		spaceJumpConnection:Disconnect()
		spaceJumpConnection = nil
	end
	
	originalSpeed = 16
	originalJump = 50
	SpeedBox.Text = ""
	JumpBox.Text = ""
	
	if walkSpeedConnection then
		walkSpeedConnection:Disconnect()
		walkSpeedConnection = nil
	end
	if jumpPowerConnection then
		jumpPowerConnection:Disconnect()
		jumpPowerConnection = nil
	end
	
	if player.Character then
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = 16
			hum.UseJumpPower = true
			hum.JumpPower = 50
			hum.JumpHeight = 50/7
			hum.PlatformStand = false
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end
	end
	
	if playersSectionOpen then
		playersSectionOpen = false
		TweenService:Create(PlayersSection, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 1, 0)
		}):Play()
		task.delay(0.32, function()
			if not playersSectionOpen then
				PlayersSection.Visible = false
			end
		end)
	end
end

RestartButton.MouseButton1Click:Connect(function()
	if restartRunning then return end
	restartRunning = true
	
	RestartButton.Text = "RESTART"
	RestartButton.BackgroundColor3 = Color3.fromRGB(0,80,40)
	RestartButton.TextColor3 = THEME.Success
	rStroke.Color = THEME.Success
	
	task.wait(1)
	
	RestartButton.BackgroundColor3 = Color3.fromRGB(80,60,0)
	RestartButton.TextColor3 = THEME.Warning
	rStroke.Color = THEME.Warning
	
	for i = 5, 1, -1 do
		RestartButton.Text = "RESTART " .. i
		task.wait(1)
	end
	
	local success, err = pcall(function()
		doFullRestart()
	end)
	
	if not success then
