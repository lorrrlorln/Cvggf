-- ✅ فحص إذا كان اللاعب يحمل Knife (في Backpack أو Character)
local function hasKnife(p)
	if not p then return false end
	local backpack = p:FindFirstChild("Backpack")
	if backpack and backpack:FindFirstChild("Knife") then return true end
	local char = p.Character
	if char and char:FindFirstChild("Knife") then return true end
	return false
end

-- ✅ فحص إذا كان اللاعب يحمل Gun (في Backpack أو Character)
local function hasGun(p)
	if not p then return false end
	local backpack = p:FindFirstChild("Backpack")
	if backpack and backpack:FindFirstChild("Gun") then return true end
	local char = p.Character
	if char and char:FindFirstChild("Gun") then return true end
	return false
end

-- ✅ دالة تحدد لون الـ ECP حسب الحالة
-- Gun → أزرق
-- Knife → أحمر
-- الباقي → أخضر
local function getECPColor(p)
	if hasGun(p) then
		return Color3.fromRGB(0, 100, 255)   -- 🔵 أزرق
	end
	if hasKnife(p) then
		return Color3.fromRGB(255, 0, 0)     -- 🔴 أحمر
	end
	return Color3.fromRGB(0, 255, 0)         -- 🟢 أخضر
end

-- ✅ دالة تحدد ألوان صف القائمة
-- ترجع: rowBg, rowText
local function getRowColors(p)
	if hasGun(p) then
		return Color3.fromRGB(10, 40, 100), Color3.fromRGB(100, 180, 255)  -- 🔵 أزرق
	end
	if hasKnife(p) then
		return Color3.fromRGB(80, 10, 10), Color3.fromRGB(255, 60, 60)     -- 🔴 أحمر
	end
	return Color3.fromRGB(10, 60, 25), Color3.fromRGB(0, 220, 100)          -- 🟢 أخضر
end

-- ==================================================
-- ========== ECP SYSTEM ==========
-- ==================================================
local ecpEnabled = false
local ecpConnection = nil
local ecpHighlights = {}
local ecpConnections = {}

local function createECPHighlight(char, color)
	local hl = Instance.new("Highlight")
	hl.Name = "ECP_Highlight"
	hl.FillColor = color
	hl.FillTransparency = 0.25
	hl.OutlineColor = Color3.fromRGB(0, 0, 0)
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = char
	hl.Parent = ScreenGui
	return hl
end

local function applyECP(targetPlayer)
	if not targetPlayer or targetPlayer == player then return end
	local char = targetPlayer.Character
	if not char then return end
	
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if hum.Health <= 0 then
		if ecpHighlights[targetPlayer] then
			ecpHighlights[targetPlayer]:Destroy()
			ecpHighlights[targetPlayer] = nil
		end
		return
	end
	
	-- ✅ نحدد اللون المطلوب حسب الحالة
	local newColor = getECPColor(targetPlayer)
	
	local existing = ecpHighlights[targetPlayer]
	if not existing or not existing.Parent or existing.Adornee ~= char then
		if existing then existing:Destroy() end
		ecpHighlights[targetPlayer] = createECPHighlight(char, newColor)
	else
		if existing.FillColor ~= newColor then
			existing.FillColor = newColor
		end
	end
end

local function removeECP(targetPlayer)
	if ecpHighlights[targetPlayer] then
		ecpHighlights[targetPlayer]:Destroy()
		ecpHighlights[targetPlayer] = nil
	end
end

local function hookECPPlayer(p)
	if ecpConnections[p] then return end
	local conn
	conn = p.CharacterAdded:Connect(function(char)
		if not ecpEnabled then return end
		char:WaitForChild("Humanoid", 5)
		task.wait(0.3)
		if ecpEnabled then
			applyECP(p)
		end
	end)
	ecpConnections[p] = conn
end

local function unhookECPPlayer(p)
	if ecpConnections[p] then
		ecpConnections[p]:Disconnect()
		ecpConnections[p] = nil
	end
end

local function startECPLoop()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			hookECPPlayer(p)
			applyECP(p)
		end
	end
	
	if ecpConnection then ecpConnection:Disconnect() end
	ecpConnection = RunService.Heartbeat:Connect(function()
		if not ecpEnabled then return end
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				applyECP(p)
			end
		end
	end)
end

local function enableECP()
	if ecpEnabled then return end
	ecpEnabled = true
	ECPButton.Text = "ECP ON"
	ECPButton.TextColor3 = THEME.Success
	ECPButton.BackgroundColor3 = Color3.fromRGB(0, 80, 40)
	ecpStroke.Color = THEME.Success
	startECPLoop()
	updateStatus("ECP: 🔵Gun 🔴Knife 🟢Normal", "success")
end

local function disableECP()
	if not ecpEnabled then return end
	ecpEnabled = false
	ECPButton.Text = "ECP OFF"
	ECPButton.TextColor3 = THEME.Error
	ECPButton.BackgroundColor3 = Color3.fromRGB(30,30,40)
	ecpStroke.Color = Color3.fromRGB(255,0,0)
	
	if ecpConnection then
		ecpConnection:Disconnect()
		ecpConnection = nil
	end
	
	for p, hl in pairs(ecpHighlights) do
		if hl then hl:Destroy() end
	end
	ecpHighlights = {}
	
	for p, conn in pairs(ecpConnections) do
		if conn then conn:Disconnect() end
	end
	ecpConnections = {}
	
	updateStatus("ECP disabled", "warning")
end

