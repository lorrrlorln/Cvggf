		return
	end
	if whitelist[selectedPlayer] then
		updateStatus("🛡 " .. selectedPlayer.Name .. " is whitelisted!", "error")
		return
	end
	
	if tpsEnabled then
		tpsEnabled = false
		tpsBtn.TextColor3 = THEME.Warning
		tpsBtn.BackgroundColor3 = Color3.fromRGB(30,30,40)
		if tpsConnection then
			tpsConnection:Disconnect()
			tpsConnection = nil
		end
		updateStatus("TPS disabled", "warning")
	else
		tpsEnabled = true
		tpsBtn.TextColor3 = THEME.Warning
		tpsBtn.BackgroundColor3 = Color3.fromRGB(60,45,10)
		
		if tpsConnection then
			tpsConnection:Disconnect()
		end
		
		tpsConnection = RunService.Heartbeat:Connect(function()
			if not tpsEnabled then return end
			if nearestEnabled then return end
			if not selectedPlayer or selectedPlayer == player then return end
			
			if isDeadOrGone(selectedPlayer) or whitelist[selectedPlayer] then
				local myHRP = getHRP(player)
				if not myHRP then return end
				
				local closest, closestDist = nil, math.huge
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= player and not isDeadOrGone(p) and not whitelist[p] then
						local tHRP = getHRP(p)
						if tHRP then
							local d = (tHRP.Position - myHRP.Position).Magnitude
							if d < closestDist then
								closestDist = d
								closest = p
							end
						end
					end
				end
				
				if closest then
					selectedPlayer = closest
					refreshPlayerList()
					updateStatus("Switched to " .. closest.Name, "warning")
				else
					tpsEnabled = false
					tpsBtn.TextColor3 = THEME.Warning
					tpsBtn.BackgroundColor3 = Color3.fromRGB(30,30,40)
					if tpsConnection then
						tpsConnection:Disconnect()
						tpsConnection = nil
					end
					updateStatus("No valid players - TPS stopped", "error")
					return
				end
			end
			
			teleportTo(selectedPlayer)
		end)
		
		updateStatus("TPS enabled -> " .. selectedPlayer.Name, "success")
	end
end)

