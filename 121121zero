-- ========== NOCLIP ==========
local function enableNoclip()
	if noclip then return end
	noclip = true
	NoclipButton.Text = "ON"
	NoclipButton.TextColor3 = THEME.Success
	NoclipButton.BackgroundColor3 = Color3.fromRGB(0,60,30)
	updateStatus("Noclip enabled", "success")
end

local function disableNoclip()
	if not noclip then return end
	noclip = false
	NoclipButton.Text = "OFF"
	NoclipButton.TextColor3 = THEME.Error
	NoclipButton.BackgroundColor3 = Color3.fromRGB(30,30,40)
	updateStatus("Noclip disabled", "warning")
	
	if player.Character then
		for _, part in pairs(player.Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
		local head = player.Character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			head.CanCollide = false
		end
	end
end

NoclipButton.MouseButton1Click:Connect(function()
	if noclip then
		disableNoclip()
	else
		enableNoclip()
	end
end)

-- ========== NOCLIP PLAYERS ==========
local noclipPlayers = false
local noclipPlayersConnection
local noclipCharConnections = {}

local function applyNoclipToPlayer(targetPlayer)
	if not targetPlayer or not targetPlayer.Character then return end
	local char = targetPlayer.Character
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end
	
	for _, partName in ipairs({"HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "LeftUpperArm", "LeftLowerArm", "RightUpperArm", "RightLowerArm", "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg"}) do
		local part = char:FindFirstChild(partName)
		if part and part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
end

local function removeNoclipFromPlayer(targetPlayer)
	if not targetPlayer or not targetPlayer.Character then return end
	local char = targetPlayer.Character
	
	for _, part in pairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = true
		end
	end
	local head = char:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		head.CanCollide = false
	end
end

local function hookPlayer(targetPlayer)
	local conn
	conn = targetPlayer.CharacterAdded:Connect(function()
		if noclipPlayers then
			task.wait(0.1)
			applyNoclipToPlayer(targetPlayer)
		end
	end)
	table.insert(noclipCharConnections, conn)
end

local function startNoclipPlayersLoop()
	if noclipPlayersConnection then
		noclipPlayersConnection:Disconnect()
	end
	
	for _, otherPlayer in pairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			applyNoclipToPlayer(otherPlayer)
		end
	end
	
	for _, p in pairs(Players:GetPlayers()) do
		hookPlayer(p)
	end
	
	noclipPlayersConnection = RunService.Stepped:Connect(function()
		if not noclipPlayers then return end
		for _, otherPlayer in pairs(Players:GetPlayers()) do
			if otherPlayer ~= player then
				applyNoclipToPlayer(otherPlayer)
			end
		end
	end)
end

