local function refreshPlayerList()
	if not PlayersSection.Visible then return end
	
	for _, child in pairs(scroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	
	local players = Players:GetPlayers()
	local myHRP = getHRP(player)
	local myPos = myHRP and myHRP.Position or Vector3.new()
	
	if nearestEnabled and myHRP then
		table.sort(players, function(a, b)
			if a == player then return false end
			if b == player then return true end
			local aHRP = getHRP(a)
			local bHRP = getHRP(b)
			local distA = aHRP and (aHRP.Position - myPos).Magnitude or math.huge
			local distB = bHRP and (bHRP.Position - myPos).Magnitude or math.huge
			return distA < distB
		end)
	end
	
	for i, p in ipairs(players) do
		local isMe = (p == player)
		local isWhitelisted = whitelist[p] == true
		
		local row = Instance.new("Frame", scroll)
		row.Size = UDim2.new(1, -6, 0, 44)
		row.BackgroundTransparency = 1
		row.BorderSizePixel = 0
		row.ZIndex = 12
		row.LayoutOrder = i
		
		local btn = Instance.new("TextButton", row)
		btn.Size = UDim2.new(0.82, -4, 1, 0)
		btn.Position = UDim2.new(0, 0, 0, 0)
		btn.BackgroundColor3 = Color3.fromRGB(15,15,22)
		btn.TextColor3 = THEME.Text
		btn.Font = Enum.Font.GothamBold
		btn.TextScaled = true
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.ZIndex = 13
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0,8)
		
		local wBtn = Instance.new("TextButton", row)
		wBtn.Size = UDim2.new(0.18, -4, 1, 0)
		wBtn.Position = UDim2.new(0.82, 4, 0, 0)
		wBtn.Text = "W"
		wBtn.Font = Enum.Font.GothamBlack
		wBtn.TextScaled = true
		wBtn.BorderSizePixel = 0
		wBtn.AutoButtonColor = false
		wBtn.ZIndex = 13
		Instance.new("UICorner", wBtn).CornerRadius = UDim.new(0,8)
		
		local isDead = false
		local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then
			isDead = true
		end
		
		if isMe then
			wBtn.TextColor3 = Color3.fromRGB(100,100,100)
			wBtn.BackgroundColor3 = Color3.fromRGB(20,20,25)
			wBtn.Text = "—"
			local s = Instance.new("UIStroke", wBtn)
			s.Color = Color3.fromRGB(60,60,60)
			s.Thickness = 1
			s.Transparency = 0.5
		else
			if isWhitelisted then
				wBtn.BackgroundColor3 = Color3.fromRGB(0,80,40)
				wBtn.TextColor3 = THEME.Success
				local s = Instance.new("UIStroke", wBtn)
				s.Color = THEME.Success
				s.Thickness = 2
				s.Transparency = 0.3
			else
				wBtn.BackgroundColor3 = Color3.fromRGB(40,40,45)
				wBtn.TextColor3 = Color3.fromRGB(255,255,255)
				local s = Instance.new("UIStroke", wBtn)
				s.Color = Color3.fromRGB(255,255,255)
				s.Thickness = 1.5
				s.Transparency = 0.5
			end
		end
		
		local distText = ""
		local tHRP = getHRP(p)
		if myHRP and tHRP and not isDead then
			local d = math.floor((tHRP.Position - myPos).Magnitude)
			distText = " [" .. d .. "]"
		end
		
		local nameStr = p.Name
		if isMe then
			nameStr = nameStr .. " (YOU)"
		elseif isDead then
			nameStr = nameStr .. " (DEAD)"
		end
		if isWhitelisted and not isMe then
			nameStr = "🛡 " .. nameStr
		end
		
		-- ✅ أيقونة حسب السلاح
		if not isMe then
			if hasGun(p) then
				nameStr = "🔫 " .. nameStr
			elseif hasKnife(p) then
				nameStr = "🔪 " .. nameStr
			end
		end
		
		btn.Text = nameStr .. distText
		
		-- ✅ ألوان الصف حسب الحالة
		local rowBg, rowText = getRowColors(p)
		
		if isDead then
			btn.TextColor3 = Color3.fromRGB(255,80,80)
			btn.BackgroundColor3 = Color3.fromRGB(40,10,10)
		elseif selectedPlayer == p then
			btn.BackgroundColor3 = Color3.fromRGB(0,80,160)
			btn.TextColor3 = THEME.Text
		else
			btn.BackgroundColor3 = rowBg
			btn.TextColor3 = rowText
		end
		
		btn.MouseEnter:Connect(function()
			if isDead then return end
			if selectedPlayer ~= p then
				local hoverBg = rowBg:Lerp(Color3.new(1,1,1), 0.15)
				TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = hoverBg}):Play()
			end
		end)
		btn.MouseLeave:Connect(function()
			if isDead then return end
			if selectedPlayer ~= p then
				TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = rowBg}):Play()
			end
		end)
		
		btn.MouseButton1Click:Connect(function()
			if isDead then
				updateStatus("Can't select dead player!", "error")
				return
			end
			
			selectedPlayer = p
			for _, other in pairs(scroll:GetChildren()) do
				if other:IsA("Frame") then
					local otherBtns = {}
					for _, c in ipairs(other:GetChildren()) do
						if c:IsA("TextButton") then
							table.insert(otherBtns, c)
						end
					end
					if #otherBtns >= 1 then
						local mainBtn = otherBtns[1]
						local otherPlayer = nil
						for _, pl in ipairs(Players:GetPlayers()) do
							if string.find(mainBtn.Text, pl.Name, 1, true) then
								otherPlayer = pl
								break
							end
						end
						local otherHum = otherPlayer and otherPlayer.Character and otherPlayer.Character:FindFirstChildOfClass("Humanoid")
						if not otherHum or otherHum.Health <= 0 then
							mainBtn.BackgroundColor3 = Color3.fromRGB(40,10,10)
							mainBtn.TextColor3 = Color3.fromRGB(255,80,80)
						elseif otherPlayer then
							local oBg, oText = getRowColors(otherPlayer)
							mainBtn.BackgroundColor3 = oBg
							mainBtn.TextColor3 = oText
						else
							mainBtn.BackgroundColor3 = Color3.fromRGB(15,15,22)
							mainBtn.TextColor3 = THEME.Text
						end
					end
				end
			end
			btn.BackgroundColor3 = Color3.fromRGB(0,80,160)
			btn.TextColor3 = THEME.Text
			updateStatus("Selected: " .. p.Name, "success")
		end)
		
		wBtn.MouseButton1Click:Connect(function()
			if isMe then return end
			
			if whitelist[p] then
				whitelist[p] = nil
				wBtn.BackgroundColor3 = Color3.fromRGB(40,40,45)
				wBtn.TextColor3 = Color3.fromRGB(255,255,255)
				local s = wBtn:FindFirstChildOfClass("UIStroke")
				if s then
					s.Color = Color3.fromRGB(255,255,255)
					s.Transparency = 0.5
				end
				updateStatus("Removed " .. p.Name .. " from whitelist", "warning")
			else
				whitelist[p] = true
				wBtn.BackgroundColor3 = Color3.fromRGB(0,80,40)
				wBtn.TextColor3 = THEME.Success
				local s = wBtn:FindFirstChildOfClass("UIStroke")
				if s then
					s.Color = THEME.Success
					s.Transparency = 0.3
				end
				updateStatus("🛡 Whitelisted: " .. p.Name, "success")
			end
			
			task.wait(0.05)
			refreshPlayerList()
		end)
	end
end

