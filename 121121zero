-- ==================================================
-- ========== TELEPORT FUNCTIONS ==========
-- ==================================================
local function getHRP(targetPlayer)
	if not targetPlayer or not targetPlayer.Character then return nil end
	return targetPlayer.Character:FindFirstChild("HumanoidRootPart")
end

local function isDeadOrGone(p)
	if not p or not p.Parent then return true end
	if not p.Character then return true end
	local hum = p.Character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return true end
	local hrp = p.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return true end
	return false
end

local function teleportTo(targetPlayer)
	local myHRP = getHRP(player)
	local targetHRP = getHRP(targetPlayer)
	if not myHRP or not targetHRP then return false end
	myHRP.CFrame = targetHRP.CFrame + Vector3.new(0, 3, 0)
	return true
end

