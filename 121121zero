	end
	
	startNoclip()
	
	RestartButton.BackgroundColor3 = Color3.fromRGB(30,30,40)
	RestartButton.TextColor3 = THEME.Error
	rStroke.Color = THEME.Error
	RestartButton.Text = "RESTART"
	
	restartRunning = false
	updateStatus("Script restarted", "success")
end)

