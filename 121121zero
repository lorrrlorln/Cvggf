local function updateStatus(text, type)
	StatusLabel.Text = text
	
	if type == "success" then
		StatusLabel.TextColor3 = THEME.Success
		StatusDot.TextColor3 = THEME.Success
	elseif type == "error" then
		StatusLabel.TextColor3 = THEME.Error
		StatusDot.TextColor3 = THEME.Error
	elseif type == "warning" then
		StatusLabel.TextColor3 = THEME.Warning
		StatusDot.TextColor3 = THEME.Warning
	else
		StatusLabel.TextColor3 = Color3.fromRGB(180,180,200)
		StatusDot.TextColor3 = THEME.Accent
	end
	
	task.delay(2, function()
		if StatusLabel.Text == text then
			StatusLabel.Text = "Ready"
			StatusLabel.TextColor3 = Color3.fromRGB(180,180,200)
			StatusDot.TextColor3 = THEME.Success
		end
	end)
end

-- ========== SPEED ==========
SpeedBox.FocusLost:Connect(function(enter)
	if enter then
		local num = tonumber(SpeedBox.Text)
		if num then
			originalSpeed = num
			humanoid.WalkSpeed = num
			
			if walkSpeedConnection then
				walkSpeedConnection:Disconnect()
			end
			
			walkSpeedConnection = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
				if humanoid.WalkSpeed ~= originalSpeed then
					humanoid.WalkSpeed = originalSpeed
				end
			end)
			
			updateStatus("Speed set to "..num, "success")
		elseif SpeedBox.Text ~= "" then
			updateStatus("Invalid speed", "error")
			SpeedBox.Text = ""
		end
	end
end)

SpeedResButton.MouseButton1Click:Connect(function()
	originalSpeed = 16
	SpeedBox.Text = "16"
	humanoid.WalkSpeed = 16
	
	if walkSpeedConnection then
		walkSpeedConnection:Disconnect()
